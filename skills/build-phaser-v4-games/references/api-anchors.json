  "anchors": [
    {
      "id": "game-destroy",
      "description": "Final Game teardown is deferred and accepts removeCanvas/noReturn.",
      "since": "4.0.0",
      "declaration": {
        "path": "types/phaser.d.ts",
        "scopePattern": "^\\s*class Game \\{",
        "memberPatterns": ["^\\s*destroy\\(removeCanvas: boolean, noReturn\\?: boolean\\): void;"]
      },
      "sources": [
        {
          "path": "src/core/Game.js",
          "patterns": [
            "destroy: function \\(removeCanvas, noReturn\\)",
            "this\\.pendingDestroy = true;"
          ]
        }
      ]
    },
    {
