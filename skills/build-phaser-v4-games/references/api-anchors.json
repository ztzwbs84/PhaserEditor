  "knownDivergences": [
    {
      "id": "render-texture-return-type",
      "description": "RenderTexture#render is declared void in 4.2.1 but its implementation returns this.",
      "since": "4.0.0",
      "until": "4.2.1",
      "declaration": {
        "path": "types/phaser.d.ts",
        "scopePattern": "^\\s*class RenderTexture extends Phaser\\.GameObjects\\.Image",
        "memberPatterns": ["^\\s*render\\(\\): void;"]
      },
      "sources": [
        {
          "path": "src/gameobjects/rendertexture/RenderTexture.js",
          "patterns": ["render: function \\(\\)", "this\\.texture\\.render\\(\\);[\\s\\S]*return this;"]
        }
      ]
    },
    {
      "id": "custom-context-factory-casing",
      "description": "Phaser 4.2.1 declares customContext but registers the runtime add factory as customcontext.",
      "since": "4.2.0",
      "until": "4.2.1",
      "declaration": {
        "path": "types/phaser.d.ts",
        "scopePattern": "^\\s*class GameObjectFactory \\{",
        "memberPatterns": ["customContext\\(x\\?: number, y\\?: number, children\\?: Phaser\\.GameObjects\\.GameObject\\[\\], customContextCallback\\?: Phaser\\.Types\\.GameObjects\\.CustomContext\\.CustomContextCallback\\): Phaser\\.GameObjects\\.CustomContext;"]
      },
      "sources": [
        {
          "path": "src/gameobjects/customcontext/CustomContextFactory.js",
          "patterns": ["GameObjectFactory\\.register\\('customcontext'"]
        }
      ]
    },
    {
