{
  "name": "phaser-editor",
  "version": "0.1.0",
  "private": true,
  "author": "Phaser Editor Team",
  "description": "A commercial-grade desktop editor for Phaser projects",
  "main": "out/main/index.js",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "npm run typecheck && electron-vite build && node scripts/assert-authoring-chunks.mjs",
    "build:assert-chunks": "node scripts/assert-authoring-chunks.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@esotericsoftware/spine-phaser-v4": "4.2.119",
    "@esotericsoftware/spine-webgl": "4.2.119",
    "@monaco-editor/react": "^4.7.0",
    "@phaser-editor/contracts": "0.1.0",
    "chokidar": "^4.0.3",
    "culori": "^4.0.2",
    "dompurify": "^3.2.6",
    "flexlayout-react": "^0.10.1",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "phaser": "4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^6.0.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.4"
  },
  "build": {
    "appId": "com.phasereditor.desktop",
    "productName": "Phaser Editor",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates"
      },
      {
        "from": "resources/plugin-host.cjs",
        "to": "plugin-host.cjs"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
